# vircampype cluster configuration (see cluster/README.md)
#
#   vircampype-cluster check  cluster.yml    # test every node first
#   vircampype-cluster start  cluster.yml    # queue the configs and start the workers
#   vircampype-cluster status cluster.yml

# Docker image. Pin a version so every node runs the same code.
image: smeingast/vircampype:2.7.0

# NAS root as mounted on THIS machine. The containers see the NAS at the same path,
# so the pipeline configs use ordinary paths below it. Several shares: give a list.
nas: /Volumes/visions

# Every *.yml below this folder is one job (names starting with _ or . are ignored).
configs: /Volumes/visions/configs/CrA

# Queue folder (created automatically); use a separate one per batch run.
queue: /Volumes/visions/queue/CrA

# Worker nodes: "local" is this machine, every other name is an SSH target.
# Optional per node: nas (where the NAS is mounted there, if different),
# scratch (fast local disk for temporary files), n_jobs (parallel jobs).
nodes:
  local:
  mini:
  tycho:
    nas: /mnt/visions
    scratch: /scratch/vircampype
    n_jobs: 16
